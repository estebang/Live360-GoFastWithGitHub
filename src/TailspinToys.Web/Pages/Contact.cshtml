@page
@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<section class="hero">
    <h1><i class="fas fa-envelope-open-text"></i> Let's Connect</h1>
    <p>Questions about the TailspinToys demo, GitHub platform workflows, or Azure deployment? Reach out any time.</p>
</section>

<div style="display: grid; gap: 2rem; margin-bottom: 2rem;">
    <div style="background: var(--card-background); border-radius: 20px; padding: 2.5rem; box-shadow: var(--shadow); position: relative; overflow: hidden;">
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--accent-color));"></div>

        <div style="display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center;">
            <div>
                <h2 style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem;">Esteban Garcia</h2>
                <p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.7;">
                    I am always open to collaboration, speaking opportunities, and conversations about modern DevOps and AI-assisted engineering.
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
                    <a href="mailto:esteban@outlook.com" style="text-decoration: none; color: var(--text-primary); background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 0.75rem 1rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                        <i class="fas fa-envelope" style="color: var(--primary-color);"></i>
                        esteban@outlook.com
                    </a>
                    <a href="https://www.linkedin.com/in/estebang/" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: var(--text-primary); background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 0.75rem 1rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                        <i class="fab fa-linkedin" style="color: #0a66c2;"></i>
                        LinkedIn Profile
                    </a>
                    <a href="https://github.com/estebang" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: var(--text-primary); background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 0.75rem 1rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                        <i class="fab fa-github" style="color: #24292f;"></i>
                        GitHub
                    </a>
                </div>
            </div>

            <div style="text-align: center; min-width: 210px;">
                <div style="background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); color: white; border-radius: 18px; padding: 2rem 1.25rem; box-shadow: var(--shadow);">
                    <div style="font-size: 2.5rem; margin-bottom: 0.75rem;"><i class="fas fa-comments"></i></div>
                    <div style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem;">Open to Connect</div>
                    <div style="font-size: 0.95rem; opacity: 0.9;">Cloud, DevOps, GitHub, AI</div>
                </div>
            </div>
        </div>
    </div>

    <div style="background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.25); border-radius: 16px; padding: 1.5rem; color: white;">
        <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;"><i class="fas fa-bolt"></i> Quick Response</h3>
        <p style="opacity: 0.92; margin: 0;">
            For the fastest response, email is best. You can also reach out through LinkedIn for session follow-ups and collaboration discussions.
        </p>
    </div>
</div>